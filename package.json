{
  "name": "dsh-z",
  "version": "0.3.0",
  "description": "DSH-Z — 可定制的 DeepSeek Harness 桌面端（内嵌 Web GUI + 原生能力）",
  "main": "src/main/index.js",
  "license": "MIT",
  "author": "DSH-Z contributors",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "npx electron-builder --config release/electron-builder.yml",
    "dist:mac": "npx electron-builder --config release/electron-builder.yml --mac",
    "dist:win": "npx electron-builder --config release/electron-builder.yml --win",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "bin": {
    "dsh-z": "scripts/cli.js"
  }
}